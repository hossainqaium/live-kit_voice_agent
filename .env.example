# ---------------------------------------------------------------------------
# Local development configuration.
#
# Copy to .env and adjust. This file is for DEVELOPMENT ONLY.
#
# Production credentials come from a secret manager — Kubernetes Secrets, or
# preferably Vault / AWS Secrets Manager / Google Secret Manager / Azure Key
# Vault. Never commit real credentials, and never put them in source code,
# Docker images, logs, frontend code, plaintext configuration or agent
# prompts (spec 54).
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info

# --- Ports on the host -----------------------------------------------------
# HOST-side ports only; inside the compose network services always use their
# standard ports. This project owns a dedicated block so it cannot collide
# with other stacks on the same machine (5432/6379/8000/3000/9000/9090 are all
# commonly taken). A collision surfaces as "port is already allocated" partway
# through `compose up`, leaving the stack half-started.
#
# Verify before changing:  make preflight
API_PORT=8200
WORKER_HEALTH_PORT=8202
FRONTEND_PORT=3200
GRAFANA_PORT=3201
PROMETHEUS_PORT=9290
MINIO_PORT=9200
MINIO_CONSOLE_PORT=9201
POSTGRES_PORT=5435
REDIS_PORT=6381
LIVEKIT_PORT=7980
LIVEKIT_TCP_PORT=7981
LIVEKIT_METRICS_PORT=6889

# SIP and media ports are NOT host-remappable. livekit-sip announces its own
# port in SIP headers and LiveKit advertises its RTC ports in ICE candidates,
# so host and container must match:
#   SIP        5060/udp + 5060/tcp   (deploy/livekit/livekit-sip.yaml: sip_port)
#   RTP media  10100-10149/udp       (deploy/livekit/livekit-sip.yaml: rtp_port)
#   RTC media  50100-50149/udp       (deploy/livekit/livekit.yaml: rtc.port_range_*)
# To change one, change it in the compose file and the LiveKit config together.

# --- SIP media reachability ------------------------------------------------
# The address livekit-sip advertises in SIP Contact headers and SDP. It must be
# an address the PBX can route to. Inside Docker, livekit-sip only knows its
# bridge address (172.x.y.z), which a PBX on another host cannot reach — and
# because signalling still succeeds, the symptom is silent or one-way audio
# rather than a failed call.
#
# Detect it with:  ./scripts/lan-ip.sh
# Leave empty only when the PBX runs on this same Docker network.
SIP_NAT_IP=

# Networks livekit-sip trusts for inbound SIP. Traffic from outside them is
# rejected as a flood ("486 Busy", reason "flood") before authentication.
#
# Docker Desktop for macOS rewrites inbound source addresses into a public
# range, so a LAN PBX looks untrusted and every call is refused. 0.0.0.0/0 is
# the development answer; on Linux or Kubernetes the real source address
# survives, so narrow this to the actual PBX networks there.
SIP_LOCAL_NET=

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=voice_agent
POSTGRES_USER=voice_agent
POSTGRES_PASSWORD=voice_agent

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-change-me

# Envelope key for provider and SIP credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- LiveKit ---------------------------------------------------------------
# Must match deploy/livekit/livekit.yaml and livekit-sip.yaml.
# The secret must be at least 32 characters or LiveKit refuses to start.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-at-least-32-characters-long
LIVEKIT_SIP_URI=sip:livekit-sip:5060

# --- Object storage --------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET_RECORDINGS=recordings

# --- Worker ----------------------------------------------------------------
WORKER_AGENT_NAME=voice-agent
# A starting point, not a capacity claim. The real figure comes from load
# testing in Phase 8 (spec 49, 74).
WORKER_MAX_CONCURRENT_CALLS=10
# Must exceed the longest expected call so a deploy never cuts one off (spec 51).
WORKER_DRAIN_TIMEOUT_SECONDS=600

# --- Monitoring ------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# AI provider bootstrap keys — DEVELOPMENT ONLY.
#
# Provider credentials are normally tenant configuration, stored encrypted in
# PostgreSQL and managed through the UI (spec 9). These exist only to seed a
# local environment before any provider row is configured.
# ---------------------------------------------------------------------------
BOOTSTRAP_DEEPGRAM_API_KEY=
BOOTSTRAP_OPENAI_API_KEY=
BOOTSTRAP_ANTHROPIC_API_KEY=
BOOTSTRAP_ELEVENLABS_API_KEY=
