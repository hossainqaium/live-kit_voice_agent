{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "uid": "voice-platform-workers",
  "title": "Voice Platform — Worker Fleet",
  "description": "Per-pod call load, HPA decisions, drain events, memory and CPU per worker, and provider-level call distribution.",
  "tags": ["voice", "workers", "hpa", "capacity"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "graphTooltip": 1,
  "links": [
    { "title": "Platform Overview", "url": "/d/voice-platform-overview", "type": "link", "icon": "external link", "targetBlank": false },
    { "title": "Latency & Quality", "url": "/d/voice-platform-latency", "type": "link", "icon": "external link", "targetBlank": false }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Data source",
        "hide": 0,
        "current": {},
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "pod",
        "type": "query",
        "label": "Pod",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(voice_worker_active_calls, kubernetes_pod_name)", "refId": "A" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "hide": 0,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Fleet Summary",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Active Worker Pods",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "count(voice_worker_active_calls)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 2 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Active Calls",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum(voice_worker_active_calls)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 15 }, { "color": "red", "value": 50 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto", "orientation": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Capacity",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum(voice_worker_max_concurrent_calls)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto", "orientation": "auto" }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Fleet Load Ratio",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum(voice_worker_active_calls) / sum(voice_worker_max_concurrent_calls)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Calls Completed (1 h)",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(voice_calls_total{state=\"completed\"}[1h]))" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto", "orientation": "auto" }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Draining Pods",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "count(voice_worker_draining == 1) or vector(0)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto" }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Per-Pod Load",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Active Calls per Pod",
      "description": "Each series is one pod.  The dashed line is the per-pod capacity ceiling.",
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{kubernetes_pod_name}}", "expr": "voice_worker_active_calls{kubernetes_pod_name=~\"$pod\"}" },
        { "refId": "B", "legendFormat": "max/pod", "expr": "avg(voice_worker_max_concurrent_calls)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": false, "showPoints": "auto" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "max/pod" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "right", "calcs": ["lastNotNull", "max"] }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Current Pod State",
      "description": "Per-pod snapshot: active calls, capacity, load ratio, draining status.",
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "voice_worker_active_calls{kubernetes_pod_name=~\"$pod\"}", "instant": true, "format": "table" },
        { "refId": "B", "expr": "voice_worker_max_concurrent_calls{kubernetes_pod_name=~\"$pod\"}", "instant": true, "format": "table" },
        { "refId": "C", "expr": "voice_worker_active_calls{kubernetes_pod_name=~\"$pod\"} / voice_worker_max_concurrent_calls{kubernetes_pod_name=~\"$pod\"}", "instant": true, "format": "table" },
        { "refId": "D", "expr": "voice_worker_draining{kubernetes_pod_name=~\"$pod\"}", "instant": true, "format": "table" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value #C" }, "properties": [{ "id": "unit", "value": "percentunit" }, { "id": "displayName", "value": "Load" }, { "id": "color", "value": { "mode": "thresholds" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 }] } }, { "id": "custom.displayMode", "value": "color-background" }] },
          { "matcher": { "id": "byName", "options": "Value #D" }, "properties": [{ "id": "displayName", "value": "Draining" }, { "id": "mappings", "value": [{ "type": "value", "options": { "1": { "text": "YES", "color": "yellow" }, "0": { "text": "no", "color": "green" } } }] }, { "id": "custom.displayMode", "value": "color-background" }] },
          { "matcher": { "id": "byName", "options": "Value #A" }, "properties": [{ "id": "displayName", "value": "Active" }] },
          { "matcher": { "id": "byName", "options": "Value #B" }, "properties": [{ "id": "displayName", "value": "Max" }] },
          { "matcher": { "id": "byName", "options": "kubernetes_pod_name" }, "properties": [{ "id": "displayName", "value": "Pod" }] }
        ]
      },
      "options": { "showHeader": true },
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true } } }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "HPA & Scaling Events",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "voice_worker_load_ratio — HPA Custom Metric",
      "description": "The metric the HPA reads.  Scale-up fires when this exceeds the target (dashed line, default 0.7).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{kubernetes_pod_name}}", "expr": "voice_worker_active_calls{kubernetes_pod_name=~\"$pod\"} / voice_worker_max_concurrent_calls{kubernetes_pod_name=~\"$pod\"}" },
        { "refId": "B", "legendFormat": "HPA target (0.7)", "expr": "vector(0.7)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1.1,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": false, "showPoints": "auto" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "HPA target (0.7)" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Fleet Total: Active vs Capacity",
      "description": "Watch for the active line approaching the capacity ceiling — a sign the HPA needs to add pods.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "total active", "expr": "sum(voice_worker_active_calls)" },
        { "refId": "B", "legendFormat": "total capacity", "expr": "sum(voice_worker_max_concurrent_calls)" },
        { "refId": "C", "legendFormat": "HPA target threshold", "expr": "sum(voice_worker_max_concurrent_calls) * 0.7" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": false, "showPoints": "auto" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "total capacity" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } }, { "id": "custom.fillOpacity", "value": 0 }] },
          { "matcher": { "id": "byName", "options": "HPA target threshold" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [4, 4] } }, { "id": "custom.fillOpacity", "value": 0 }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Resource Usage (per pod)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "CPU Usage — AI Worker Pods",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{kubernetes_pod_name}}", "expr": "sum by (kubernetes_pod_name) (rate(container_cpu_usage_seconds_total{pod=~\".*ai-agent-worker.*\",container=\"ai-agent-worker\"}[$__rate_interval]))" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores", "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": false, "showPoints": "auto" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Memory Usage — AI Worker Pods",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{kubernetes_pod_name}}", "expr": "container_memory_working_set_bytes{pod=~\".*ai-agent-worker.*\",container=\"ai-agent-worker\"}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes", "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": false, "showPoints": "auto" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      }
    }
  ]
}
