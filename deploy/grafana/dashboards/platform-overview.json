{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" }
  ],
  "uid": "voice-platform-overview",
  "title": "Voice Platform — Overview",
  "description": "Top-level platform health: active calls, worker capacity, call success rate, LiveKit drift, provider circuit breakers, tenant activity.",
  "tags": ["voice", "overview", "sre"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "graphTooltip": 1,
  "links": [
    { "title": "Latency & Quality", "url": "/d/voice-platform-latency", "type": "link", "icon": "external link", "targetBlank": false },
    { "title": "Worker Fleet", "url": "/d/voice-platform-workers", "type": "link", "icon": "external link", "targetBlank": false }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Data source",
        "hide": 0,
        "current": {},
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "tenant_id",
        "type": "query",
        "label": "Tenant",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(voice_active_calls, tenant_id)", "refId": "A" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "hide": 0,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Live Platform State",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Active Calls",
      "description": "Total calls in progress right now across all tenants.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "", "expr": "sum(voice_active_calls{tenant_id=~\"$tenant_id\"})" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 20 },
            { "color": "red", "value": 80 }
          ]}
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto", "orientation": "auto" }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Fleet Load",
      "description": "Average active-calls / max-slots across all worker pods. Green < 70 %, yellow 70–90 %, red > 90 %.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "Load ratio", "expr": "avg(voice_worker_active_calls / voice_worker_max_concurrent_calls)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.7 },
            { "color": "red", "value": 0.9 }
          ]}
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Worker Pods",
      "description": "Number of ai-agent-worker pods currently running (as seen by Prometheus).",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "", "expr": "count(voice_worker_active_calls)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "green", "value": 2 }
          ]}
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Call Success Rate (1 h)",
      "description": "Fraction of calls completed successfully over the past hour.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "",
          "expr": "sum(increase(voice_calls_total{tenant_id=~\"$tenant_id\",state=\"completed\"}[1h])) / sum(increase(voice_calls_total{tenant_id=~\"$tenant_id\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.95 },
            { "color": "green", "value": 0.99 }
          ]}
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "LiveKit Drift",
      "description": "Number of SIP trunks or dispatch rules currently drifted from PostgreSQL.",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "", "expr": "sum(api_livekit_drift_detected)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]}
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto" }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Open Circuit Breakers",
      "description": "Count of provider circuit breakers currently OPEN (failing fast). Any value > 0 is actionable.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "", "expr": "count(voice_provider_circuit_state == 2) or vector(0)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]}
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto" }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Call Volume",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Active Calls Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "active", "expr": "sum(voice_active_calls{tenant_id=~\"$tenant_id\"})" },
        { "refId": "B", "legendFormat": "worker capacity", "expr": "sum(voice_worker_max_concurrent_calls)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "gradientMode": "none", "spanNulls": false, "showPoints": "auto" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "worker capacity" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 5] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Call Completions and Failures per Minute",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "completed/min", "expr": "sum(rate(voice_calls_total{tenant_id=~\"$tenant_id\",state=\"completed\"}[$__rate_interval])) * 60" },
        { "refId": "B", "legendFormat": "failed/min", "expr": "sum(rate(voice_calls_total{tenant_id=~\"$tenant_id\",state=\"failed\"}[$__rate_interval])) * 60" },
        { "refId": "C", "legendFormat": "rejected (limit)/min", "expr": "sum(rate(voice_calls_rejected_total{tenant_id=~\"$tenant_id\"}[$__rate_interval])) * 60" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm", "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "gradientMode": "none", "spanNulls": false, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "failed/min" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "rejected (limit)/min" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Per-Tenant Activity",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "id": 20,
      "type": "barchart",
      "title": "Active Calls by Tenant",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{tenant_id}}", "expr": "sum by (tenant_id) (voice_active_calls{tenant_id=~\"$tenant_id\"})", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "fillOpacity": 80,
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "hidden" }
      }
    },
    {
      "id": 21,
      "type": "table",
      "title": "Tenant Call Summary (1 h)",
      "description": "Calls completed, failed, total duration, and average duration per tenant over the past hour.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "completed", "expr": "sum by (tenant_id) (increase(voice_calls_total{tenant_id=~\"$tenant_id\",state=\"completed\"}[1h]))", "instant": true, "format": "table" },
        { "refId": "B", "legendFormat": "failed", "expr": "sum by (tenant_id) (increase(voice_calls_total{tenant_id=~\"$tenant_id\",state=\"failed\"}[1h]))", "instant": true, "format": "table" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "tenant_id" }, "properties": [{ "id": "displayName", "value": "Tenant" }, { "id": "custom.width", "value": 200 }] },
          { "matcher": { "id": "byName", "options": "Value #B" }, "properties": [{ "id": "color", "value": { "mode": "thresholds" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }] }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Value #A", "desc": true }]
      },
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "renameByName": { "Value #A": "Completed", "Value #B": "Failed" } } }
      ]
    },
    {
      "id": 103,
      "type": "row",
      "title": "Service Health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "API Latency p95 — Configuration API",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "p95 {{method}} {{handler}}", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"configuration-api\"}[$__rate_interval])) by (le, method, handler))" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s", "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": false, "showPoints": "auto" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 2.0 }] }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "API Error Rate — Configuration API",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "5xx / min", "expr": "sum(rate(http_requests_total{job=\"configuration-api\",status=~\"5..\"}[$__rate_interval])) * 60" },
        { "refId": "B", "legendFormat": "4xx / min", "expr": "sum(rate(http_requests_total{job=\"configuration-api\",status=~\"4..\"}[$__rate_interval])) * 60" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm", "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "spanNulls": false, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx / min" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "4xx / min" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      }
    }
  ]
}
