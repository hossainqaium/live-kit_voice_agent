{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" }
  ],
  "uid": "voice-platform-latency",
  "title": "Voice Platform — Latency & Quality",
  "description": "Per-turn STT / LLM / TTS latency, composite voice-quality metrics, call volume and provider health (spec 56, Plan 2b.6).",
  "tags": ["voice", "latency", "livekit", "realtime"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Data source",
        "hide": 0,
        "current": {},
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "tenant_id",
        "type": "query",
        "label": "Tenant",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(voice_active_calls, tenant_id)", "refId": "A" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "hide": 0,
        "current": {},
        "options": []
      },
      {
        "name": "agent_id",
        "type": "query",
        "label": "Agent",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(voice_calls_total{tenant_id=~\"$tenant_id\"}, agent_id)", "refId": "A" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "hide": 0,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Time to First Audio — p50 / p95",
      "description": "End of caller speech → first audio frame the caller hears. The metric that best represents perceived lag (spec 56).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum(rate(voice_time_to_first_audio_seconds_bucket{tenant_id=~\"$tenant_id\", agent_id=~\"$agent_id\"}[$__rate_interval])) by (le))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum(rate(voice_time_to_first_audio_seconds_bucket{tenant_id=~\"$tenant_id\", agent_id=~\"$agent_id\"}[$__rate_interval])) by (le))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1.0 },
              { "color": "red", "value": 2.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "End-to-End Response Latency — p50 / p95",
      "description": "End of caller speech → end of agent utterance. Total turn round-trip time (spec 56).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum(rate(voice_end_to_end_response_latency_seconds_bucket{tenant_id=~\"$tenant_id\", agent_id=~\"$agent_id\"}[$__rate_interval])) by (le))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum(rate(voice_end_to_end_response_latency_seconds_bucket{tenant_id=~\"$tenant_id\", agent_id=~\"$agent_id\"}[$__rate_interval])) by (le))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Calls",
      "description": "Calls currently in progress across all tenants.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "Active",
          "expr": "sum(voice_active_calls{tenant_id=~\"$tenant_id\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Worker Utilization",
      "description": "Fraction of the worker's capacity currently used. 1.0 = fully saturated.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "Utilization",
          "expr": "voice_worker_utilization_ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Call Rate (completed / failed per minute)",
      "description": "Successful and failed calls per minute. A spike in failures alongside high latency suggests provider issues.",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "completed",
          "expr": "sum(rate(voice_calls_total{tenant_id=~\"$tenant_id\", agent_id=~\"$agent_id\", state=\"completed\"}[$__rate_interval])) * 60"
        },
        {
          "refId": "B",
          "legendFormat": "failed",
          "expr": "sum(rate(voice_calls_total{tenant_id=~\"$tenant_id\", agent_id=~\"$agent_id\", state=\"failed\"}[$__rate_interval])) * 60"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "failed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Call Duration p95",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum(rate(voice_call_duration_seconds_bucket{tenant_id=~\"$tenant_id\"}[$__rate_interval])) by (le))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Interruptions / min",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "interruptions/min",
          "expr": "sum(rate(voice_interruptions_total{tenant_id=~\"$tenant_id\"}[$__rate_interval])) * 60"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Pipeline Breakdown",
      "description": "Per-stage latency for diagnosing where time is spent in each turn.",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "STT Latency — p50 / p95 by Provider",
      "description": "Speech-to-text transcription time. Self-hosted Whisper on CPU is typically the ceiling at scale (spec 56).",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50 {{provider}}",
          "expr": "histogram_quantile(0.50, sum(rate(voice_stt_latency_seconds_bucket{tenant_id=~\"$tenant_id\", agent_id=~\"$agent_id\"}[$__rate_interval])) by (le, provider))"
        },
        {
          "refId": "B",
          "legendFormat": "p95 {{provider}}",
          "expr": "histogram_quantile(0.95, sum(rate(voice_stt_latency_seconds_bucket{tenant_id=~\"$tenant_id\", agent_id=~\"$agent_id\"}[$__rate_interval])) by (le, provider))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "p95"] }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "LLM First Token Latency — p50 / p95 by Provider",
      "description": "Time from end of STT to the first token from the language model (spec 56).",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50 {{provider}} / {{model}}",
          "expr": "histogram_quantile(0.50, sum(rate(voice_llm_first_token_latency_seconds_bucket{tenant_id=~\"$tenant_id\", agent_id=~\"$agent_id\"}[$__rate_interval])) by (le, provider, model))"
        },
        {
          "refId": "B",
          "legendFormat": "p95 {{provider}} / {{model}}",
          "expr": "histogram_quantile(0.95, sum(rate(voice_llm_first_token_latency_seconds_bucket{tenant_id=~\"$tenant_id\", agent_id=~\"$agent_id\"}[$__rate_interval])) by (le, provider, model))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "p95"] }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "TTS First Audio Latency — p50 / p95 by Provider",
      "description": "Time from first LLM token to first audio frame sent to the caller (spec 56).",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50 {{provider}}",
          "expr": "histogram_quantile(0.50, sum(rate(voice_tts_first_audio_latency_seconds_bucket{tenant_id=~\"$tenant_id\", agent_id=~\"$agent_id\"}[$__rate_interval])) by (le, provider))"
        },
        {
          "refId": "B",
          "legendFormat": "p95 {{provider}}",
          "expr": "histogram_quantile(0.95, sum(rate(voice_tts_first_audio_latency_seconds_bucket{tenant_id=~\"$tenant_id\", agent_id=~\"$agent_id\"}[$__rate_interval])) by (le, provider))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "p95"] }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Time to First Response — p50 / p95",
      "description": "End of caller speech → first LLM token (STT + EOU detection). The first response metric isolates the input pipeline (spec 56).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum(rate(voice_time_to_first_response_seconds_bucket{tenant_id=~\"$tenant_id\", agent_id=~\"$agent_id\"}[$__rate_interval])) by (le))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum(rate(voice_time_to_first_response_seconds_bucket{tenant_id=~\"$tenant_id\", agent_id=~\"$agent_id\"}[$__rate_interval])) by (le))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Call Duration — p50 / p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum(rate(voice_call_duration_seconds_bucket{tenant_id=~\"$tenant_id\"}[$__rate_interval])) by (le))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum(rate(voice_call_duration_seconds_bucket{tenant_id=~\"$tenant_id\"}[$__rate_interval])) by (le))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Provider Health",
      "description": "Circuit breaker state, fallback activations, and error rates per provider.",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Circuit Breaker State (0=closed, 1=half-open, 2=open)",
      "description": "0 = healthy (CLOSED). 1 = probing (HALF_OPEN). 2 = failing (OPEN — all requests fail fast). Any value ≥ 1 warrants investigation.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{kind}} / {{provider}}",
          "expr": "voice_provider_circuit_state"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto",
            "thresholdsStyle": { "mode": "area" }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Provider Requests — success / error rate",
      "description": "Request outcomes per provider kind. Rising errors without a circuit-breaker opening means the threshold has not been reached yet.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "success {{kind}} / {{provider}}",
          "expr": "sum(rate(voice_provider_requests_total{outcome=\"success\"}[$__rate_interval])) by (kind, provider)"
        },
        {
          "refId": "B",
          "legendFormat": "error {{kind}} / {{provider}}",
          "expr": "sum(rate(voice_provider_requests_total{outcome!=\"success\"}[$__rate_interval])) by (kind, provider)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "^error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Provider Fallback Activations",
      "description": "How often the FallbackAdapter trips to the next provider. A flat line means the primary provider is healthy.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{kind}}: {{primary}} → {{fallback}}",
